# Copia este archivo como .env y completa los valores reales.
# Nunca subas el archivo .env al repositorio.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
GLOBAL_IP=127.0.0.1
GLOBAL_HOST=3000

# Base de datos MySQL
DB_NAME=rabbit_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Redis (Socket.IO / Channels)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Servicios externos (opcionales)
GOOGLE_MAPS_API_KEY=
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
